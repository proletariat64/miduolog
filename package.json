{
  "name": "mido-mistake-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/operations/bootstrap-worktree.mjs",
    "dev": "node scripts/operations/start-dev.mjs",
    "verify:worktree": "node scripts/verification/verify-worktree-bootstrap.mjs",
    "start": "node app/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:codex": "node scripts/verification/verify-codex.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run docs:check && npm test",
    "docs:check": "node scripts/checks/doc-guard.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "marked": "^18.1.1"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
